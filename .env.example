# Supabase (Project Settings > API). Projeto na região São Paulo.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Somente no servidor (NUNCA com prefixo NEXT_PUBLIC_). Usada só pelo cron de reenvio de e-mails.
SUPABASE_SECRET_KEY=

# URL pública do app (usada nos links dos convites). Em produção: https://seu-dominio
NEXT_PUBLIC_APP_URL=http://localhost:3000

# E-mail via Resend. EMAIL_REMETENTE precisa de domínio verificado no Resend, ex.: "eCondomínio <avisos@seu-dominio.com.br>"
# Sem domínio verificado o Resend só entrega para o e-mail dono da conta.
RESEND_API_KEY=
EMAIL_REMETENTE=

# Segredo do cron (Vercel envia "Authorization: Bearer <CRON_SECRET>"). Gere um valor longo e aleatório.
CRON_SECRET=

# WhatsApp via Evolution API (servidor próprio; API NÃO oficial: o número pode ser banido).
# Sem estas 3 variáveis o canal fica desligado (só e-mail e portal).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Pausa mínima entre mensagens de WhatsApp, em ms (padrão 4000; com variação de até +50%).
WHATSAPP_INTERVALO_MS=4000
